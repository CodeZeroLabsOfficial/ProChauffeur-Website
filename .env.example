# ProChauffeur Website — copy to .env.local for local dev.
# NEXT_PUBLIC_* values are exposed to the browser. Use the same Firebase stamp
# as the operations portal and mobile apps.

# Firebase Web app (Project settings → General → Your apps → SDK config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match FUNCTIONS_REGION used when deploying Cloud Functions for this stamp.
NEXT_PUBLIC_FUNCTIONS_REGION=australia-southeast1

# Mapbox public token (URL-restrict to this site’s host in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Stripe publishable key for web checkout (secret keys stay in Functions).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
